{
  "defaultMode": "acceptEdits",
  "permissions": {
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Edit(app/**)",
      "Edit(config/**)",
      "Edit(README.md)",
      "Edit(build.gradle.kts)",
      "Edit(settings.gradle.kts)",
      "Edit(gradle.properties)",
      "Edit(local.properties)",
      "Write(app/**)",
      "Write(config/**)",
      "Write(README.md)",
      "Write(build.gradle.kts)",
      "Write(settings.gradle.kts)",
      "Write(gradle.properties)",
      "Write(local.properties)",
      "Bash(powershell -ExecutionPolicy Bypass -Command \"& .\\scripts\\ensure-claude-dirs.ps1\")",
      "Bash(powershell -ExecutionPolicy Bypass -Command \"& .\\scripts\\lightweight-format.ps1\")",
      "Bash(powershell -ExecutionPolicy Bypass -Command \"& .\\scripts\\block-dangerous-command.ps1 '$CLAUDE_TOOL_INPUT'\")",
      "Bash(powershell -ExecutionPolicy Bypass -Command \"& .\\scripts\\validate.ps1\")",
      "Bash(powershell -ExecutionPolicy Bypass -Command \"& .\\scripts\\require-validation-report.ps1\")"
    ],
    "deny": [
      "Edit(.claude/reports/**)",
      "Write(.claude/reports/**)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.local.json)",
      "Edit(.claude/agents/**)",
      "Write(.claude/agents/**)",
      "Edit(.claude/skills/**)",
      "Write(.claude/skills/**)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(scripts/validate.ps1)",
      "Write(scripts/validate.ps1)",
      "Edit(scripts/require-validation-report.ps1)",
      "Write(scripts/require-validation-report.ps1)",
      "Edit(scripts/write-validation-report.ps1)",
      "Write(scripts/write-validation-report.ps1)",
      "Edit(scripts/block-dangerous-command.ps1)",
      "Write(scripts/block-dangerous-command.ps1)",
      "Edit(scripts/ensure-claude-dirs.ps1)",
      "Write(scripts/ensure-claude-dirs.ps1)",
      "Bash(.\\gradlew.bat *)",
      "Bash(cmd.exe /c \"gradlew.bat *\")",
      "Bash(cmd.exe /c \".\\\\gradlew.bat *\")",
      "Bash(powershell *)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(Remove-Item * -Recurse -Force*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -Command \"& .\\scripts\\lightweight-format.ps1\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -Command \"& .\\scripts\\block-dangerous-command.ps1 '$CLAUDE_TOOL_INPUT'\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -Command \"& .\\scripts\\require-validation-report.ps1\""
          }
        ]
      }
    ]
  }
}