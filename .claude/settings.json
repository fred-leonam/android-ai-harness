{
  "defaultMode": "acceptEdits",
  "permissions": {
    "allow": [
      "Bash(powershell -ExecutionPolicy Bypass -File .\\scripts\\validate.ps1)",
      "Bash(powershell -ExecutionPolicy Bypass -File .\\scripts\\lightweight-format.ps1)",
      "Bash(.\\gradlew.bat :app:compileDebugKotlin)",
      "Bash(.\\gradlew.bat :app:testDebugUnitTest)",
      "Bash(.\\gradlew.bat :app:detekt)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Edit(*)",
      "Write(*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(Remove-Item * -Recurse -Force*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File .\\scripts\\lightweight-format.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File .\\scripts\\block-dangerous-command.ps1 \"$CLAUDE_TOOL_INPUT\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File .\\scripts\\require-validation-report.ps1"
          }
        ]
      }
    ]
  }
}